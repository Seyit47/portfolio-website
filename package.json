{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "lhci": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "check:resume": "tsx scripts/check-resume.ts",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:resume && pnpm e2e && pnpm lhci",
    "prepare": "husky"
  },
  "dependencies": {
    "@content-collections/core": "^0.15.3",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "^2.0.1",
    "cmdk": "^1.1.1",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "schema-dts": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{cjs,md,mdx,yaml,yml,json,css}": [
      "prettier --write"
    ]
  }
}
