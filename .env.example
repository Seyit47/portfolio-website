# Public site origin, used for canonical URLs, sitemap and Open Graph images.
SITE_URL=http://localhost:3000

# Resend API key. When missing, the contact form logs the message instead of sending it.
RESEND_API_KEY=
# Sender address on a domain verified in Resend. Defaults to onboarding@resend.dev in development.
CONTACT_FROM=

# Upstash Redis REST credentials for contact-form rate limiting. When missing, rate limiting is a no-op.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret salt mixed into the hashed client IP used as the rate-limit key.
CONTACT_IP_SALT=change-me

# Test hook: set to 1 to make the contact form simulate a delivery failure.
CONTACT_FORCE_FAIL=
